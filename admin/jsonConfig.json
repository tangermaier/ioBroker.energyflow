					"sort": false,
					"width": "6%",
					"default": "#8892a0"
				},
				{
					"type": "select",
					"label": "LBL_item_powerSource",
					"tooltip": "TTIP_item_powerSource",
					"attr": "powerSource",
					"hidden": "data.category !== 'grid' && data.category !== 'storage'",
					"filter": false,
					"sort": false,
					"width": "8%",
					"options": [
						{
							"value": "measured",
							"label": "OPT_powerSource_measured"
						},
						{
							"value": "balance",
							"label": "OPT_powerSource_balance"
						},
						{
							"value": "measuredWithFallback",
							"label": "OPT_powerSource_fallback"
						}
					],
					"default": "measured"
				},
				{
					"type": "number",
					"label": "LBL_item_staleAfterS",
					"tooltip": "TTIP_item_staleAfterS",
					"attr": "staleAfterS",
					"hidden": "data.powerSource !== 'measuredWithFallback'",
					"min": 10,
					"step": 10,
					"width": "5%",
					"default": 120
				},
				{
					"type": "objectId",
					"label": "LBL_item_fallbackStateId",
