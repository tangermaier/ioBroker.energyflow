				{
					"type": "select",
					"label": "LBL_item_category",
					"tooltip": "TTIP_item_category",
					"attr": "category",
					"filter": false,
					"sort": false,
					"width": "10%",
					"options": [
						{
							"value": "producer",
							"label": "OPT_producer"
						},
						{
							"value": "consumer",
							"label": "OPT_consumer"
						},
						{
							"value": "storage",
							"label": "OPT_storage"
						},
						{
							"value": "grid",
							"label": "OPT_grid"
