					"max": 100,
					"step": 1,
					"width": "8%",
					"default": 100
				},
				{
					"type": "number",
					"label": "LBL_item_maxPowerKW",
					"tooltip": "TTIP_item_maxPowerKW",
					"attr": "maxPowerKW",
					"hidden": "data.category !== 'storage'",
					"min": 0,
					"step": 0.1,
					"width": "8%",
					"default": 0
