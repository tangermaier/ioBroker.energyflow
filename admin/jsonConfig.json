					"types": ["state"],
					"hidden": "data.powerSource !== 'measuredWithFallback'",
					"width": "12%"
				},
				{
					"type": "checkbox",
					"label": "LBL_item_fallbackInvertSign",
					"tooltip": "TTIP_item_fallbackInvertSign",
					"attr": "fallbackInvertSign",
					"hidden": "data.powerSource !== 'measuredWithFallback' || !data.fallbackStateId",
					"width": "4%",
					"default": false
				},
				{
					"type": "objectId",
					"label": "LBL_item_inverterAcStateId",
					"tooltip": "TTIP_item_inverterAcStateId",
					"attr": "inverterAcStateId",
					"types": ["state"],
					"hidden": "data.category !== 'storage'",
					"width": "12%"
				},
				{
					"type": "text",
					"label": "LBL_item_inverterPvIds",
					"tooltip": "TTIP_item_inverterPvIds",
					"attr": "inverterPvIds",
					"hidden": "data.category !== 'storage' || !data.inverterAcStateId",
					"width": "10%"
